{
  "name": "react-native-drop-shadow",
  "version": "2.0.1",
  "description": "Beautiful cross-platform shadows for React Native, with automatic boxShadow rendering and a legacy Android fallback.",
  "main": "lib/commonjs/index",
  "module": "lib/module/index",
  "react-native": "src/index",
  "source": "src/index",
  "types": "lib/typescript/module/index.d.ts",
  "files": [
    "src",
    "lib",
    "android",
    "img/main.png",
    "img/example_legacy.png",
    "img/example_modern.png",
    "react-native.config.js",
    "!android/build",
    "!android/src/test",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "example": "yarn workspace DropShadowModern",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"**/*.{js,cjs,ts,tsx}\"",
    "clean": "del-cli android/build examples/legacy/android/build examples/legacy/android/app/build examples/legacy/ios/build examples/modern/android/build examples/modern/android/app/build examples/modern/ios/build lib",
    "prepare": "bob build",
    "release": "release-it"
  },
  "keywords": [
    "react-native",
    "ios",
    "shadow",
    "drop-shadow",
    "box-shadow",
    "android",
    "fabric"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hoanglam10499/react-native-drop-shadow.git"
  },
  "author": "Hoang Lam <hoanglam10499@gmail.com> (https://github.com/hoanglam10499)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/hoanglam10499/react-native-drop-shadow/issues"
  },
  "homepage": "https://github.com/hoanglam10499/react-native-drop-shadow#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@commitlint/config-conventional": "^17.0.2",
    "@evilmartians/lefthook": "^1.5.0",
    "@react-native/babel-preset": "0.88.1",
    "@react-native/eslint-config": "0.88.1",
    "@react-native/jest-preset": "0.88.1",
    "@release-it/conventional-changelog": "^9.0.2",
    "@types/jest": "^29.5.5",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "commitlint": "^17.0.2",
    "del-cli": "^5.1.0",
    "eslint": "^8.51.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.1",
    "jest": "^29.7.0",
    "prettier": "^3.0.3",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-builder-bob": "^0.44.1",
    "react-test-renderer": "19.3.0",
    "release-it": "^17.10.0",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "workspaces": [
    "examples/legacy",
    "examples/modern",
    "examples/web"
  ],
  "packageManager": "yarn@3.6.1",
  "jest": {
    "preset": "@react-native/jest-preset",
    "modulePathIgnorePatterns": [
      "<rootDir>/examples/",
      "<rootDir>/lib/"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release ${version}",
      "tagName": "v${version}"
    },
    "npm": {
      "publish": true
    },
    "github": {
      "release": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": "angular"
      }
    }
  },
  "eslintConfig": {
    "root": true,
    "plugins": [
      "prettier"
    ],
    "extends": [
      "@react-native",
      "prettier"
    ],
    "rules": {
      "react/react-in-jsx-scope": "off",
      "prettier/prettier": [
        "error",
        {
          "quoteProps": "consistent",
          "singleQuote": true,
          "tabWidth": 2,
          "trailingComma": "es5",
          "useTabs": false
        }
      ]
    }
  },
  "eslintIgnore": [
    "node_modules/",
    ".yarn/",
    "lib/",
    "android/build/",
    "examples/*/android/build/",
    "examples/*/android/app/build/",
    "examples/web/dist/",
    "examples/web/dist-server/",
    "examples/web/test-results/"
  ],
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "commonjs",
        {
          "esm": true,
          "jsxRuntime": "classic"
        }
      ],
      [
        "module",
        {
          "esm": true,
          "jsxRuntime": "classic"
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  }
}
